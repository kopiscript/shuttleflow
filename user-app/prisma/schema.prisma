generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Bus {
  id                Int                   @id @default(autoincrement())
  busName           String                @map("bus_name")
  licensePlate      String                @map("license_plate")
  capacity          Int?
  status            String                @default("Active")
  driverName        String?               @map("driver_name")
  driverPhone       String?               @map("driver_phone")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  driver_name       String?
  driver_phone      String?
  activityLogs      ActivityLog[]
  deviceAssignments BusDeviceAssignment[]
  routeAssignments  BusRouteAssignment[]
  locations         Location[]

  @@map("buses")
}

model Route {
  id                        Int                  @id @default(autoincrement())
  routeName                 String               @map("route_name")
  pickupStop                String               @map("pickup_stop")
  dropoffStop               String               @map("dropoff_stop")
  intermediateStops         String[]             @map("intermediate_stops")
  status                    String               @default("Active")
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  pickupLat                 Float?               @map("pickup_lat")
  pickupLng                 Float?               @map("pickup_lng")
  dropoffLat                Float?               @map("dropoff_lat")
  dropoffLng                Float?               @map("dropoff_lng")
  alertedForCurrentApproach Boolean              @default(false) @map("alerted_for_current_approach")
  arrivedAtPickupAt         DateTime?            @map("arrived_at_pickup_at")
  expectedTripMinutes       Int?                 @map("expected_trip_minutes")
  busAssignments            BusRouteAssignment[]
  views                     RouteView[]

  @@map("routes")
}

model Device {
  id             Int                   @id @default(autoincrement())
  deviceName     String                @map("device_name")
  status         String                @default("Offline")
  lastSeen       DateTime?             @map("last_seen")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  busAssignments BusDeviceAssignment[]

  @@map("devices")
}

model BusRouteAssignment {
  id         Int       @id @default(autoincrement())
  busId      Int       @map("bus_id")
  routeId    Int       @map("route_id")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  endedAt    DateTime? @map("ended_at")
  bus        Bus       @relation(fields: [busId], references: [id])
  route      Route     @relation(fields: [routeId], references: [id])

  @@map("bus_route_assignments")
}

model BusDeviceAssignment {
  id         Int       @id @default(autoincrement())
  busId      Int       @map("bus_id")
  deviceId   Int       @map("device_id")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  endedAt    DateTime? @map("ended_at")
  bus        Bus       @relation(fields: [busId], references: [id])
  device     Device    @relation(fields: [deviceId], references: [id])

  @@map("bus_device_assignments")
}

model Location {
  id         Int      @id @default(autoincrement())
  busId      Int      @map("bus_id")
  latitude   Decimal  @db.Decimal(10, 8)
  longitude  Decimal  @db.Decimal(11, 8)
  speed      Decimal? @db.Decimal(5, 2)
  recordedAt DateTime @default(now()) @map("recorded_at")
  bus        Bus      @relation(fields: [busId], references: [id])

  @@index([busId, recordedAt(sort: Desc)])
  @@map("locations")
}

model Admin {
  id                Int             @id @default(autoincrement())
  username          String          @unique
  passwordHash      String          @map("password_hash")
  email             String          @unique
  createdAt         DateTime        @default(now()) @map("created_at")
  role              AdminRole       @default(ADMIN)
  resetToken        String?         @map("reset_token")
  resetTokenExpiry  DateTime?       @map("reset_token_expiry")
  emailChangeExpiry DateTime?       @map("email_change_expiry")
  emailChangeToken  String?         @map("email_change_token")
  pendingEmail      String?         @map("pending_email")
  adminAuditLogs    AdminAuditLog[]

  @@map("admins")
}

model SupportTicket {
  id          Int           @id @default(autoincrement())
  description String
  status      String        @default("Unresolved")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  email       String
  fileUrl     String?
  reportType  String
  replies     TicketReply[]

  @@map("support_tickets")
}

model TicketReply {
  id       Int           @id @default(autoincrement())
  ticketId Int           @map("ticket_id")
  message  String
  sentBy   String        @default("admin") @map("sent_by")
  sentAt   DateTime      @default(now()) @map("sent_at")
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_replies")
}

model Notification {
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(200)
  message   String
  createdAt DateTime @default(now()) @map("created_at")
  isRead    Boolean  @default(false)
  id        Int      @id @default(autoincrement())

  @@map("notifications")
}

model email_subscribers {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  verified   Boolean   @default(false)
  token      String    @unique
  createdAt  DateTime  @default(now())
  verifiedAt DateTime?
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  busId       Int      @map("bus_id")
  eventType   String   @map("event_type")
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  bus         Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

model AdminAuditLog {
  id         Int           @id @default(autoincrement())
  adminId    Int?          @map("admin_id")
  category   AuditCategory
  action     String
  targetType String?       @map("target_type")
  targetId   String?       @map("target_id")
  details    Json?
  ipAddress  String?       @map("ip_address")
  createdAt  DateTime      @default(now()) @map("created_at")
  admin      Admin?        @relation(fields: [adminId], references: [id])

  @@index([category, createdAt])
  @@index([adminId])
  @@map("admin_audit_logs")
}

model RouteView {
  id       Int      @id @default(autoincrement())
  routeId  Int      @map("route_id")
  viewedAt DateTime @default(now()) @map("viewed_at")
  route    Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId, viewedAt])
  @@map("route_views")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum AuditCategory {
  AUTH
  FLEET
  SETTINGS
}
