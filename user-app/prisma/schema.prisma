generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Bus {
  id                Int                   @id @default(autoincrement())
  busName           String                @map("bus_name")
  licensePlate      String                @map("license_plate")
  capacity          Int?
  status            String                @default("Active")
  driverName        String?               @map("driver_name")
  driverPhone       String?               @map("driver_phone")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  activity_logs     activity_logs[]
  deviceAssignments BusDeviceAssignment[]
  routeAssignments  BusRouteAssignment[]
  locations         Location[]

  @@map("buses")
}

model Route {
  id                        Int                  @id @default(autoincrement())
  routeName                 String               @map("route_name")
  pickupStop                String               @map("pickup_stop")
  dropoffStop               String               @map("dropoff_stop")
  intermediateStops         String[]             @map("intermediate_stops")
  status                    String               @default("Active")
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  pickupLat                 Float?               @map("pickup_lat")
  pickupLng                 Float?               @map("pickup_lng")
  dropoffLat                Float?               @map("dropoff_lat")
  dropoffLng                Float?               @map("dropoff_lng")
  alertedForCurrentApproach Boolean              @default(false) @map("alerted_for_current_approach")
  arrived_at_pickup_at      DateTime?
  busAssignments            BusRouteAssignment[]
  views                     RouteView[]

  @@map("routes")
}

model Device {
  id             Int                   @id @default(autoincrement())
  deviceName     String                @map("device_name")
  status         String                @default("Offline")
  lastSeen       DateTime?             @map("last_seen")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  busAssignments BusDeviceAssignment[]

  @@map("devices")
}

model BusRouteAssignment {
  id         Int       @id @default(autoincrement())
  busId      Int       @map("bus_id")
  routeId    Int       @map("route_id")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  endedAt    DateTime? @map("ended_at")
  bus        Bus       @relation(fields: [busId], references: [id])
  route      Route     @relation(fields: [routeId], references: [id])

  @@map("bus_route_assignments")
}

model BusDeviceAssignment {
  id         Int       @id @default(autoincrement())
  busId      Int       @map("bus_id")
  deviceId   Int       @map("device_id")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  endedAt    DateTime? @map("ended_at")
  bus        Bus       @relation(fields: [busId], references: [id])
  device     Device    @relation(fields: [deviceId], references: [id])

  @@map("bus_device_assignments")
}

model Location {
  id         Int      @id @default(autoincrement())
  busId      Int      @map("bus_id")
  latitude   Decimal  @db.Decimal(10, 8)
  longitude  Decimal  @db.Decimal(11, 8)
  speed      Decimal? @db.Decimal(5, 2)
  recordedAt DateTime @default(now()) @map("recorded_at")
  bus        Bus      @relation(fields: [busId], references: [id])

  @@index([busId, recordedAt(sort: Desc)])
  @@map("locations")
}

model Admin {
  id                  Int                @id @default(autoincrement())
  username            String             @unique
  passwordHash        String             @map("password_hash")
  email               String             @unique
  createdAt           DateTime           @default(now()) @map("created_at")
  role                AdminRole          @default(ADMIN)
  reset_token         String?
  reset_token_expiry  DateTime?
  email_change_expiry DateTime?
  email_change_token  String?
  pending_email       String?
  admin_audit_logs    admin_audit_logs[]

  @@map("admins")
}

model Notification {
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(200)
  message   String
  createdAt DateTime @default(now()) @map("created_at")
  isRead    Boolean  @default(false)
  id        Int      @id @default(autoincrement())

  @@map("notifications")
}

model SupportTicket {
  id             Int              @id @default(autoincrement())
  description    String
  status         String           @default("Unresolved")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  email          String
  fileUrl        String?
  reportType     String
  ticket_replies ticket_replies[]

  @@map("support_tickets")
}

model EmailSubscriber {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  verified   Boolean   @default(false)
  token      String    @unique
  createdAt  DateTime  @default(now())
  verifiedAt DateTime?

  @@map("email_subscribers")
}

model activity_logs {
  id          Int      @id @default(autoincrement())
  bus_id      Int
  event_type  String
  description String
  created_at  DateTime @default(now())
  buses       Bus      @relation(fields: [bus_id], references: [id], onDelete: Cascade)
}

model RouteView {
  id       Int      @id @default(autoincrement())
  routeId  Int      @map("route_id")
  viewedAt DateTime @default(now()) @map("viewed_at")
  route    Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId, viewedAt])
  @@map("route_views")
}

model admin_audit_logs {
  id          Int           @id @default(autoincrement())
  admin_id    Int?
  category    AuditCategory
  action      String
  target_type String?
  target_id   String?
  details     Json?
  ip_address  String?
  created_at  DateTime      @default(now())
  admins      Admin?        @relation(fields: [admin_id], references: [id])

  @@index([admin_id])
  @@index([category, created_at])
}

model ticket_replies {
  id              Int           @id @default(autoincrement())
  ticket_id       Int
  message         String
  sent_by         String        @default("admin")
  sent_at         DateTime      @default(now())
  support_tickets SupportTicket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum AuditCategory {
  AUTH
  FLEET
  SETTINGS
}
